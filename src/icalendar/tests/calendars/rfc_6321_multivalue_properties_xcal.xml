<?xml version="1.0" encoding="utf-8"?>
<icalendar xmlns="urn:ietf:params:xml:ns:icalendar-2.0">
  <vcalendar>
    <properties>
      <prodid>
        <text>-//Example Inc.//Example Calendar//EN</text>
      </prodid>
      <version>
        <text>2.0</text>
      </version>
    </properties>
    <components>
      <!-- several multi-value properties with two values each -->
      <vevent>
        <properties>
          <uid>
            <text>multivalue@example.com</text>
          </uid>
          <dtstamp>
            <date-time>2026-10-25T10:00:00Z</date-time>
          </dtstamp>
          <dtstart>
            <date-time>2026-10-26T09:00:00Z</date-time>
          </dtstart>
          <summary>
            <text>Multi-value properties</text>
          </summary>
          <categories>
            <text>Work</text>
            <text>Meeting</text>
          </categories>
          <resources>
            <text>Projector</text>
            <text>Whiteboard</text>
          </resources>
          <exdate>
            <date-time>2026-11-02T09:00:00Z</date-time>
            <date-time>2026-11-09T09:00:00Z</date-time>
          </exdate>
          <rdate>
            <date-time>2026-12-01T09:00:00Z</date-time>
          </rdate>
        </properties>
      </vevent>
      <!-- the same properties with a single value each -->
      <vevent>
        <properties>
          <uid>
            <text>singlevalue@example.com</text>
          </uid>
          <dtstamp>
            <date-time>2026-10-25T10:00:00Z</date-time>
          </dtstamp>
          <dtstart>
            <date-time>2026-10-26T09:00:00Z</date-time>
          </dtstart>
          <summary>
            <text>Single-value properties</text>
          </summary>
          <categories>
            <text>Work</text>
          </categories>
          <resources>
            <text>Projector</text>
          </resources>
          <exdate>
            <date-time>2026-11-02T09:00:00Z</date-time>
          </exdate>
          <rdate>
            <date-time>2026-12-01T09:00:00Z</date-time>
          </rdate>
        </properties>
      </vevent>
      <!-- FREEBUSY uses PERIOD values, see RFC 6321 Section 3.4.1.2 -->
      <vfreebusy>
        <properties>
          <uid>
            <text>freebusy@example.com</text>
          </uid>
          <dtstamp>
            <date-time>2026-10-25T10:00:00Z</date-time>
          </dtstamp>
          <dtstart>
            <date-time>2026-10-26T09:00:00Z</date-time>
          </dtstart>
          <dtend>
            <date-time>2026-10-27T09:00:00Z</date-time>
          </dtend>
          <freebusy>
            <period>
              <start>2026-10-26T09:00:00Z</start>
              <end>2026-10-26T10:00:00Z</end>
            </period>
            <period>
              <start>2026-10-26T13:00:00Z</start>
              <end>2026-10-26T14:00:00Z</end>
            </period>
          </freebusy>
        </properties>
      </vfreebusy>
      <!-- FREEBUSY with a single period value -->
      <vfreebusy>
        <properties>
          <uid>
            <text>freebusy-single@example.com</text>
          </uid>
          <dtstamp>
            <date-time>2026-10-25T10:00:00Z</date-time>
          </dtstamp>
          <dtstart>
            <date-time>2026-10-27T09:00:00Z</date-time>
          </dtstart>
          <dtend>
            <date-time>2026-10-28T09:00:00Z</date-time>
          </dtend>
          <freebusy>
            <period>
              <start>2026-10-27T09:00:00Z</start>
              <end>2026-10-27T10:00:00Z</end>
            </period>
          </freebusy>
        </properties>
      </vfreebusy>
    </components>
  </vcalendar>
</icalendar>
