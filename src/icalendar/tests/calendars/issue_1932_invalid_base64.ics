BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//icalendar//BASE64 tests//EN
BEGIN:VEVENT
UID:text-padding
SUMMARY;ENCODING=BASE64:SGVsbG8
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:text-alphabet
SUMMARY;ENCODING=BASE64:!!!
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:text-ascii
SUMMARY;ENCODING=BASE64:é
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:text-utf8
SUMMARY;ENCODING=BASE64:/w==
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:binary-padding
ATTACH;VALUE=BINARY;ENCODING=BASE64:SGVsbG8
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:binary-alphabet
ATTACH;VALUE=BINARY;ENCODING=BASE64:!!!
LOCATION:Elsewhere
END:VEVENT
BEGIN:VEVENT
UID:binary-ascii
ATTACH;VALUE=BINARY;ENCODING=BASE64:é
LOCATION:Elsewhere
END:VEVENT
END:VCALENDAR
